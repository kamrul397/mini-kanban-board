generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VIEWER
  EDITOR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Boards owned by this user
  ownedBoards  Board[]        @relation("BoardOwner")
  // Boards shared with this user
  boardMembers BoardMember[]
}

model Board {
  id          String   @id @default(uuid())
  title       String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner   User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members BoardMember[]
  columns Column[]
}

model BoardMember {
  id        String   @id @default(uuid())
  boardId   String
  userId    String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can only be added to a specific board once
  @@unique([boardId, userId])
}

model Column {
  id        String   @id @default(uuid())
  title     String
  order     Float    // Used to order columns (e.g., 0, 1, 2)
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  order       Float     // Float allows easy reordering (e.g. inserting between 1.0 and 2.0 -> 1.5)
  columnId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
}
